<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment"
    android:background="@color/fondo_perfil"
    android:orientation="vertical"
    android:id="@+id/Margen">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="@id/Margen"
        android:background="@drawable/coustom_edittext"
        android:backgroundTint="@color/white"
        app:queryHint="Buscar"
        app:iconifiedByDefault="false" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefInicio"
        android:layout_width="match_parent"
        android:layout_height="610dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/searchInicio"
        tools:layout_editor_absoluteX="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyclePubliInicio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>