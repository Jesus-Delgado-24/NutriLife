<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="20dp"
    android:padding="20dp"
    android:id="@+id/layoutDialogContainer"
    android:background="@drawable/fondologin">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/layoutDialog"
        android:background="@drawable/dialog_background"
        app:cardElevation="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/textTittle"
                    android:padding="10dp"
                    android:background="@drawable/editar_background"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="Editar perfil"
                    android:gravity="center"/>

                <ImageView
                    android:id="@+id/imageIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="0dp"
                    android:contentDescription="@string/app_name"
                    android:layout_marginStart="-50dp"
                    android:src="@drawable/ig_ajusteperfil"
                    app:tint="@color/white" />
            </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/baseline_person_24"
                    app:startIconTint="#56873C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtNomDP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="80dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawablePadding="8dp"
                        android:ems="10"
                        android:hint="Nombre (s)"
                        android:inputType="textCapSentences"
                        android:textColor="@color/black"
                        android:textColorHint="@color/cardview_dark_background"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconTint="#56873C"
                    app:startIconDrawable="@drawable/baseline_person_24"
                    >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtApePE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawablePadding="8dp"
                        android:ems="10"
                        android:hint="Apellido Paterno"
                        android:inputType="textCapSentences"
                        android:textColor="@color/black"
                        android:textColorHint="@color/cardview_dark_background"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconTint="#56873C"
                    app:startIconDrawable="@drawable/baseline_person_24"
                    >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtApeME"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawablePadding="8dp"
                        android:ems="10"
                        android:hint="Apellido Materno"
                        android:inputType="textCapSentences"
                        android:textColor="@color/black"
                        android:textColorHint="@color/cardview_dark_background"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconTint="#56873C"
                    app:startIconDrawable="@drawable/baseline_calendar_month_24"
                    >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtFechaE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawablePadding="8dp"
                        android:ems="10"
                        android:hint="Fecha de nacimiento"
                        android:inputType="none"
                        android:textColor="@color/black"
                        android:textColorHint="@color/cardview_dark_background"
                        android:focusable="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp">

                    <RadioButton
                        android:id="@+id/txtHE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawableLeft="@drawable/baseline_boy_24"
                        android:drawablePadding="1dp"
                        android:ems="10"
                        android:hint="Masculino"
                        android:textColorHint="@color/black"/>

                    <RadioButton
                        android:id="@+id/txtME"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawableLeft="@drawable/baseline_girl_24"
                        android:drawablePadding="1dp"
                        android:ems="10"
                        android:hint="Femenino"
                        android:textColorHint="@color/black"/>

                    <RadioButton
                        android:id="@+id/txtNE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/coustom_edittext"
                        android:drawablePadding="1dp"
                        android:ems="10"
                        android:hint="       Prefiero no decirlo"
                        android:textColorHint="@color/black"/>
                </RadioGroup>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCancelDatos"
                        android:layout_width="130dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="20dp"
                        android:backgroundTint="@color/neutral"
                        android:text="Cancelar"
                        android:textColor="@color/white"
                        android:textSize="17dp"
                        app:cornerRadius="20dp"/>

                    <Button
                        android:id="@+id/btnGuardarDatos"
                        android:layout_width="130dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="20dp"
                        android:backgroundTint="#A2DA8D"
                        android:text="Guardar"
                        android:textColor="@color/white"
                        android:textSize="17dp"
                        app:cornerRadius="20dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>