<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:id="@+id/layoutDialogContainer">

    <LinearLayout
        android:id="@+id/liner1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="@id/layoutDialogContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textTittle"
            android:padding="10dp"
            android:background="@drawable/editar_background"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Crear publicación"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/imageIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:layout_marginStart="-50dp"
            android:src="@drawable/baseline_create_24"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/liner1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:startIconDrawable="@drawable/baseline_create_24"
            app:startIconTint="#56873C"
            android:inputType="textCapSentences"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="119dp"
                android:background="@drawable/coustom_edittext"
                android:drawablePadding="8dp"
                android:ems="10"
                android:hint="Descripción"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="@color/black"
                android:textColorHint="@color/cardview_dark_background"
                android:lines="4"
                android:minLines="3"
                android:maxLines="6"
                android:gravity="top|start"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/igPubli"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ig_addimage" />

        <Button
            android:id="@+id/btnSubirFP"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/editper"
            app:layout_constraintBottom_toBottomOf="@id/layoutDialog"
            app:layout_constraintTop_toBottomOf="@id/layoutDialog"
            android:textSize="15dp"
            android:textColor="@color/white"
            android:text="Subir foto"/>

        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="@color/editper"
            app:layout_constraintBottom_toBottomOf="@id/layoutDialog"
            app:layout_constraintTop_toBottomOf="@id/layoutDialog"
            android:textSize="15dp"
            android:textColor="@color/white"
            android:text="Publicar"/>

        <Button
            android:id="@+id/btnReg6"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/neutral"
            app:layout_constraintBottom_toBottomOf="@id/layoutDialog"
            app:layout_constraintTop_toBottomOf="@id/layoutDialog"
            android:textSize="15dp"
            android:textColor="@color/white"
            android:text="Regresar"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>